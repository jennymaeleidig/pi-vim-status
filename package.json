{
  "name": "pi-vim-status",
  "version": "0.1.0",
  "description": "Show pi-vim-editor's mode in a Zentui Minimalist border slot, with a fallback status",
  "type": "module",
  "license": "CC0-1.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
