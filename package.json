{
  "name": "pi-vim-status",
  "version": "0.1.1",
  "description": "Show pi-vim-editor's mode in a Zentui Minimalist border slot, with a fallback status",
  "type": "module",
  "license": "CC0-1.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vim",
    "zentui",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennymaeleidig/pi-vim-status.git"
  },
  "homepage": "https://github.com/jennymaeleidig/pi-vim-status#readme",
  "bugs": {
    "url": "https://github.com/jennymaeleidig/pi-vim-status/issues"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "GLOSSARY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
